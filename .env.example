# Copy to .env locally; never commit real credentials.
# Supabase project settings (server-side)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# GeniusPay: configure real values only in Vercel Environment Variables / secret manager.
GENIUSPAY_PUBLIC_KEY="YOUR_GENIUSPAY_PUBLIC_KEY"
GENIUSPAY_SECRET_KEY="YOUR_GENIUSPAY_SECRET_KEY"
GENIUSPAY_WEBHOOK_SECRET="YOUR_GENIUSPAY_WEBHOOK_SECRET"
APP_URL="https://YOUR_PRODUCTION_DOMAIN"
GENIUSPAY_API_BASE="https://geniuspay.ci/api/v1/merchant"
GENIUSPAY_ENV="sandbox"
ROOT_ADMIN_EMAIL="founder@example.com"
ADMIN_REQUIRE_MFA="false" # Enable only after founder TOTP enrollment and tested recovery.
